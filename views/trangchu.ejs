<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>5KHY - Trang chủ chính thức</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/header', { active: 'trangchu' }) %>

<main>

    <h1 class="visually-hidden">5KHY - Cửa hàng điện thoại, máy tính bảng và PC chính hãng</h1>

    <!-- SLIDER BANNER QUẢNG CÁO -->
    <section class="slider-wrapper" aria-roledescription="carousel" aria-label="Banner quảng cáo">
        <button type="button" class="arrow-btn prev-btn" aria-label="Banner trước">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back_ios</span>
        </button>

        <div class="slider-container" id="mySlider">
            <a href="/chitiet?id=6a538042d177cc3c173a8551&type=phone" class="slide-item">
                <img src="/Hình ảnh/POSTER/DT-Samsung/Samsung-s26-ultra-POSTER.jpg" alt="Banner Quảng Cáo Samsung Galaxy S26 Ultra">
            </a>
            <a href="/chitiet?id=6a538042d177cc3c173a8558&type=phone" class="slide-item">
                <img src="/Hình ảnh/POSTER/DT-Vivo/vivo-x300-ultra.jpg" alt="Banner Quảng Cáo Vivo X300 Ultra">
            </a>
            <a href="/chitiet?id=6a538042d177cc3c173a8552&type=phone" class="slide-item">
                <img src="/Hình ảnh/POSTER/DT-Oppo/oppo-find-x9-ultra.png" alt="Banner Quảng Cáo Oppo Find X9 Ultra">
            </a>
        </div>

        <button type="button" class="arrow-btn next-btn" aria-label="Banner tiếp theo">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span>
        </button>
    </section>

    <!-- SECTON 1: ĐIỆN THOẠI -->
    <section class="product-section_phone" aria-labelledby="phone-section-title">
        <h2 class="section-title" id="phone-section-title">ĐIỆN THOẠI</h2>

        <div class="product-banners-grid">
            <a href="/chitiet?id=6a538042d177cc3c173a8563&type=phone" class="banner-item grid-big">
                <figure><img src="/Hình ảnh/POSTER/DT-Xiaomi/Xiaomi-17-POSTER.jpeg" alt="Quảng cáo Xiaomi 17"></figure>
            </a>
            <a href="/chitiet?id=6a538042d177cc3c173a8555&type=phone" class="banner-item grid-small-top">
                <figure><img src="/Hình ảnh/POSTER/DT-Xiaomi/Xiaomi-17-ultra-POSTER.jpg" alt="Quảng cáo Xiaomi 17 Ultra"></figure>
            </a>
            <a href="/chitiet?id=6a538042d177cc3c173a8551&type=phone" class="banner-item grid-small-bottom">
                <figure><img src="/Hình ảnh/POSTER/DT-Samsung/Samsung-s26-ultra-POSTER.jpg" alt="Quảng cáo Samsung Galaxy S26 Ultra"></figure>
            </a>
            <a href="/chitiet?id=6a538042d177cc3c173a8559&type=phone" class="banner-item grid-medium">
                <figure><img src="/Hình ảnh/POSTER/DT-Samsung/Samsung-zfold7-POSTER.png" alt="Quảng cáo Samsung Galaxy Z Fold7"></figure>
            </a>
        </div>

        <div class="filter-bar-phone">
            <nav class="filter-tags-phone" aria-label="Lọc điện thoại theo hãng">
                <a href="/dienthoai" class="tag-btn-phone">iPhone</a>
                <a href="/dienthoai" class="tag-btn-phone">Samsung</a>
                <a href="/dienthoai" class="tag-btn-phone">Oppo</a>
                <a href="/dienthoai" class="tag-btn-phone">Xiaomi</a>
                <a href="/dienthoai" class="tag-btn-phone">Honor</a>
            </nav>
            <a href="/dienthoai" class="view-all-btn">Xem tất cả</a>
        </div>

        <div class="product-list" id="product-container"></div>
    </section>

    <!-- SECTION 2: MÁY TÍNH BẢNG -->
    <section class="product-section_tablet" aria-labelledby="tablet-section-title">
        <h2 class="section-title" id="tablet-section-title">MÁY TÍNH BẢNG</h2>

        <div class="product-banners-grid">
            <figure class="banner-item grid-big">
                <img src="/Hình ảnh/POSTER/MTB-Samsung/samsung-galaxy-tab-s11-ultra.jpg" alt="Quảng cáo Samsung Galaxy Tab S11 Ultra">
            </figure>
            <figure class="banner-item grid-small-top">
                <img src="/Hình ảnh/POSTER/MTB-ipad/apple-pencil-pro.jpg" alt="Quảng cáo Apple Pencil Pro">
            </figure>
            <figure class="banner-item grid-small-bottom">
                <img src="/Hình ảnh/POSTER/MTB-ipad/iPad-Pro-M5.jpg" alt="Quảng cáo iPad Pro M5">
            </figure>
            <figure class="banner-item grid-medium">
                <img src="/Hình ảnh/POSTER/MTB-ipad/ipad-air.jpg" alt="Quảng cáo iPad Air">
            </figure>
        </div>

        <div class="filter-bar-tablet">
            <nav class="filter-tags-tablet" aria-label="Lọc máy tính bảng theo hãng">
                <a href="javascript:void(0)" class="tag-btn-tablet" onclick="filterTablets(event, 'Apple iPad')">Apple iPad</a>
                <a href="javascript:void(0)" class="tag-btn-tablet" onclick="filterTablets(event, 'Samsung Galaxy Tab')">Samsung Galaxy Tab</a>
                <a href="javascript:void(0)" class="tag-btn-tablet" onclick="filterTablets(event, 'Xiaomi Tab')">Xiaomi Tab</a>
            </nav>
            <a href="javascript:void(0)" class="view-all-btn active" onclick="filterTablets(event, 'all')">Xem tất cả</a>
        </div>

        <div class="product-list" id="Tablet-container"></div>
    </section>

    <!-- SECTION 3: PC DỰNG SẴN -->
    <section class="product-section_pc" aria-labelledby="pc-section-title">
        <h2 class="section-title" id="pc-section-title">PC</h2>

        <div class="filter-bar-pc">
            <nav class="filter-tags-pc" aria-label="Lọc PC theo cấu hình">
                <a href="javascript:void(0)" class="tag-btn-pc" onclick="filterPCs(event, 'Intel Core i9')">Intel Core i9</a>
                <a href="javascript:void(0)" class="tag-btn-pc" onclick="filterPCs(event, 'AMD Ryzen 9')">AMD Ryzen 9</a>
                <a href="javascript:void(0)" class="tag-btn-pc" onclick="filterPCs(event, 'RTX 5070Ti')">RTX 5070Ti</a>
                <a href="javascript:void(0)" class="tag-btn-pc" onclick="filterPCs(event, 'RTX 5060Ti')">RTX 5060Ti</a>
            </nav>
            <a href="javascript:void(0)" class="view-all-btn active" onclick="filterPCs(event, 'all')">Xem tất cả</a>
        </div>

        <div class="product-list" id="PC-container"></div>
    </section>

</main>

<%- include('partials/footer') %>

<script>
    function formatVND(price) {
        if (price === undefined || price === null || price === '' || isNaN(price)) return 'Liên hệ';
        return Number(price).toLocaleString('vi-VN') + 'đ';
    }
    // Hàm tính Rating thực tế từ mảng Reviews
    function calculateRealRating(item) {
        if (item.reviews && item.reviews.length > 0) {
            const sum = item.reviews.reduce((acc, r) => acc + (Number(r.stars) || 0), 0);
            return (sum / item.reviews.length).toFixed(1);
        }
        return "0"; // Chưa có review thì hiện 0 sao
    }

    // 1. DÃY BANNER SLIDER
    const slider = document.getElementById('mySlider');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');

    if (nextBtn && slider) nextBtn.addEventListener('click', () => slider.scrollLeft += slider.offsetWidth);
    if (prevBtn && slider) prevBtn.addEventListener('click', () => slider.scrollLeft -= slider.offsetWidth);

    // 2. LOAD SẢN PHẨM ĐIỆN THOẠI
    const productContainer = document.getElementById('product-container');
    fetch('/api/products')
        .then(res => res.json())
        .then(productsData => {
            const homepagePhones = productsData.slice(0, 5);
            productContainer.innerHTML = homepagePhones.map((product, productIndex) => {
                const variantsHtml = (product.variants || []).map((v, i) => `
                    <span class="${i === 0 ? 'active' : ''}" data-price="${formatVND(v.price)}" 
                        onclick="event.stopPropagation(); event.preventDefault(); changePrice(this, ${productIndex})">
                        ${v.storage}
                    </span>
                `).join('');

                const defaultPrice = product.variants && product.variants[0] ? formatVND(product.variants[0].price) : formatVND(product.price);
                const realRating = calculateRealRating(product);

                return `
                    <a href="/chitiet?id=${product._id}&type=phone" class="product-card-link">
                        <article class="product-card" id="prod-card-${productIndex}">
                            <figure class="prod-img"><img src="${product.img}" alt="${product.name}"></figure>
                            <div class="prod-info">
                                <h3 class="prod-name">${product.name}</h3>
                                <div class="prod-variants">${variantsHtml}</div>
                                <div class="prod-price price-display">${defaultPrice}</div>
                                <div class="prod-rating"><i class="fa-solid fa-star"></i> ${realRating}</div>
                            </div>
                        </article>
                    </a>
                `;
            }).join('');
        })
        .catch(err => console.error('Lỗi tải điện thoại:', err));

    function changePrice(element, productIndex) {
        const card = document.getElementById(`prod-card-${productIndex}`);
        if (!card) return;
        card.querySelectorAll('.prod-variants span').forEach(span => span.classList.remove('active'));
        element.classList.add('active');
        card.querySelector('.price-display').innerText = element.getAttribute('data-price');
    }

    // 3. LOAD SẢN PHẨM MÁY TÍNH BẢNG (TABLET)
    const tabletContainer = document.getElementById('Tablet-container'); 
    let allTabletsData = []; 

    fetch('/api/tablets')
        .then(res => res.json())
        .then(tabletData => {
            allTabletsData = tabletData; 
            renderTabletUI(allTabletsData); 
        })
        .catch(err => console.error('Lỗi tải máy tính bảng:', err));

    function renderTabletUI(tabletList) {
        if (!tabletContainer) return;
        if (tabletList.length === 0) {
            tabletContainer.innerHTML = `<p style="padding: 20px; color: #8e8e93;">Hiện tại chưa có sản phẩm thuộc nhóm này.</p>`;
            return;
        }

        tabletContainer.innerHTML = tabletList.map((tablet, tabletIndex) => {
            const tabletVariantsHtml = (tablet.variants || []).map((v, i) => `
                <span class="${i === 0 ? 'active' : ''}" data-price="${formatVND(v.price)}" 
                    onclick="event.stopPropagation(); event.preventDefault(); changeTabletPrice(this, ${tabletIndex})">
                    ${v.storage}
                </span>
            `).join('');

            const defaultTabletPrice = tablet.variants && tablet.variants[0] ? formatVND(tablet.variants[0].price) : formatVND(tablet.price);
            const realRating = calculateRealRating(tablet);

            return `
                <a href="/chitiet?id=${tablet._id}&type=tablet" class="product-card-link">
                    <article class="product-card" id="tablet-card-${tabletIndex}">
                        <figure class="prod-img"><img src="${tablet.img}" alt="${tablet.name}"></figure>
                        <div class="prod-info">
                            <h3 class="prod-name">${tablet.name}</h3>
                            <div class="prod-variants">${tabletVariantsHtml}</div>
                            <div class="prod-price price-display-tablet">${defaultTabletPrice}</div>
                            <div class="prod-rating"><i class="fa-solid fa-star"></i> ${realRating}</div>
                        </div>
                    </article>
                </a>
            `;
        }).join('');
    }

    function changeTabletPrice(element, tabletIndex) {
        const tabletCard = document.getElementById(`tablet-card-${tabletIndex}`);
        if (!tabletCard) return;
        tabletCard.querySelectorAll('.prod-variants span').forEach(span => span.classList.remove('active'));
        element.classList.add('active');
        tabletCard.querySelector('.price-display-tablet').innerText = element.getAttribute('data-price');
    }

    function filterTablets(e, brandName) {
        document.querySelectorAll('.tag-btn-tablet, .view-all-btn').forEach(btn => btn.classList.remove('active'));
        if (e && e.target) e.target.classList.add('active');
        if (brandName === 'all') renderTabletUI(allTabletsData); 
        else renderTabletUI(allTabletsData.filter(item => item.brand === brandName)); 
    }

    // 4. LOAD SẢN PHẨM PC DỰNG SẴN
    const pcContainer = document.getElementById('PC-container'); 
    let allPCsData = [];

    fetch('/api/pcs')
        .then(res => res.json())
        .then(pcData => {
            allPCsData = pcData; 
            renderPCUI(allPCsData); 
        })
        .catch(err => console.error('Lỗi tải PC:', err));

    function renderPCUI(pcList) {
        if (!pcContainer) return;
        if (pcList.length === 0) {
            pcContainer.innerHTML = `<p style="padding: 20px; color: #8e8e93;">Hiện tại chưa có cấu hình PC nào thuộc nhóm này.</p>`;
            return;
        }

        pcContainer.innerHTML = pcList.map((pc, pcIndex) => {
            const currentPrice = typeof pc.price === 'number' ? pc.price.toLocaleString('vi-VN') + 'đ' : (pc.price || "Liên hệ");
            const realRating = calculateRealRating(pc);

            return `
                <a href="/chitiet?id=${pc._id}&type=pc" class="product-card-link">
                    <article class="product-card" id="pc-card-${pcIndex}">
                        <figure class="prod-img"><img src="${pc.img}" alt="${pc.name}"></figure>
                        <div class="prod-info">
                            <h3 class="prod-name">${pc.name}</h3>
                            <div class="prod-price price-display-pc">${currentPrice}</div>
                            <div class="prod-rating"><i class="fa-solid fa-star"></i> ${realRating}</div>
                        </div>
                    </article>
                </a>
            `;
        }).join('');
    }

    function filterPCs(e, filterValue) {
        document.querySelectorAll('.tag-btn-pc, .view-all-btn-pc').forEach(btn => btn.classList.remove('active'));
        if (e && e.target) e.target.classList.add('active');
        if (filterValue === 'all') renderPCUI(allPCsData); 
        else renderPCUI(allPCsData.filter(item => item.brand === filterValue)); 
    }
</script>
</body>
</html>