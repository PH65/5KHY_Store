<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh toán - 5KHY</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/thanhtoan.css">
</head>
<body>
    <%- include('partials/header', { active: '' }) %>

    <main class="payment-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a></li>
                <li aria-hidden="true">&gt;</li>
                <li><a href="/giohang">Giỏ hàng</a></li>
                <li aria-hidden="true">&gt;</li>
                <li><a href="/dathang">Đặt hàng</a></li>
                <li aria-hidden="true">&gt;</li>
                <li class="active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>

        <h1 class="payment-title">Xác nhận thanh toán</h1>
        <p class="payment-subtitle">Thông tin thanh toán của bạn sẽ luôn được bảo mật 100%</p>

        <section class="qr-payment-box" aria-labelledby="qr-title">
            <h2 id="qr-title">Vui lòng quét mã QR bên dưới để thanh toán chính xác số tiền</h2>

            <div class="qr-payment-content">
                <figure class="qr-code-figure">
                    <img id="qr-code-img" src="" alt="Mã QR thanh toán Vietcombank">
                    <figcaption>Ngân hàng Vietcombank</figcaption>
                </figure>

                <div class="qr-payment-info">
                    <dl class="bank-info-list">
                        <div><dt>Ngân hàng</dt><dd>Vietcombank (VCB)</dd></div>
                        <div><dt>Số tài khoản</dt><dd>1056586174</dd></div>
                        <div><dt>Tên tài khoản</dt><dd>Công ty TNHH 5KHY</dd></div>
                        <div><dt>Số tiền cần chuyển</dt><dd id="pay-amount">0đ</dd></div>
                        <div><dt>Nội dung chuyển khoản</dt><dd class="highlight" id="pay-content">...</dd></div>
                    </dl>

                    <div class="countdown-box">
                        <span class="material-symbols-outlined" aria-hidden="true">timer</span>
                        <span>Thời gian giữ hàng: <strong id="countdown-timer">15:00</strong></span>
                    </div>

                    <p class="countdown-note">* Đơn hàng sẽ tự động hủy nếu chưa thanh toán trong 15 phút</p>
                </div>
            </div>
        </section>

        <button type="button" class="confirm-payment-btn" id="confirm-payment-btn">Xác nhận thanh toán & Hoàn tất đơn hàng</button>
        <p class="confirm-payment-hint">Vui lòng kiểm tra lại thông tin trước khi xác nhận</p>

    </main>

    <%- include('partials/footer') %>

    <script>
        function formatVND(num) {
            return num.toLocaleString('vi-VN') + 'đ';
        }

        const orderCode = new URLSearchParams(window.location.search).get('order');

        if (!orderCode) {
            alert('Không tìm thấy thông tin đơn hàng!');
            window.location.href = '/giohang';
        }

        // Khai báo biến toàn cục để quản lý bộ đếm thời gian
        let countdownInterval = null;

        async function loadOrder() {
            try {
                const res = await fetch(`/api/orders/${orderCode}`);
                const order = await res.json();
                if (!res.ok) throw new Error(order.error || 'Không tìm thấy đơn hàng.');

                document.getElementById('pay-content').textContent = order.orderCode;
                document.getElementById('pay-amount').textContent = formatVND(order.totalAmount);
                document.getElementById('qr-code-img').src =
                    `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${order.orderCode}-${order.totalAmount}`;

                // Tính thời gian đếm ngược dựa vào createdAt hoặc orderDate từ Database
                const timeSource = order.createdAt || order.orderDate;
                startCountdown(timeSource);

            } catch (err) {
                console.error('Lỗi khi tải đơn hàng:', err);
                alert('Không tải được thông tin đơn hàng!');
                window.location.href = '/giohang';
            }
        }

        function startCountdown(createdAtString) {
            if (!createdAtString) return;

            // Chuyển đổi thời gian tạo đơn sang Timestamp
            const createdAt = new Date(createdAtString).getTime();
            const expireTime = createdAt + (15 * 60 * 1000); // 15 phút sau khi tạo đơn

            const timerEl = document.getElementById('countdown-timer');

            if (countdownInterval) clearInterval(countdownInterval);

            function updateTimer() {
                const now = new Date().getTime();
                const distance = expireTime - now;

                if (distance <= 0) {
                    clearInterval(countdownInterval);
                    timerEl.textContent = "00:00";
                    alert('Đã hết thời gian giữ hàng. Đơn hàng sẽ bị hủy.');
                    window.location.href = '/giohang';
                    return;
                }

                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                const m = String(minutes).padStart(2, '0');
                const s = String(seconds).padStart(2, '0');
                timerEl.textContent = `${m}:${s}`;
            }

            updateTimer();
            countdownInterval = setInterval(updateTimer, 1000);
        }

        // Gọi hàm tải dữ liệu đơn hàng
        loadOrder();

        // Xử lý sự kiện bấm nút xác nhận thanh toán
        document.getElementById('confirm-payment-btn').addEventListener('click', async function () {
            if (countdownInterval) clearInterval(countdownInterval);
            this.disabled = true;

            try {
                const res = await fetch(`/api/orders/${orderCode}/confirm`, { method: 'PUT' });
                const order = await res.json();
                if (!res.ok) throw new Error(order.error || 'Không xác nhận được thanh toán.');

                alert('Đặt hàng thành công! Cảm ơn bạn đã mua sắm tại 5KHY. 🚀');
                window.location.href = '/';
            } catch (err) {
                alert(err.message);
                this.disabled = false;
            }
        });
    </script>
</body>
</html>