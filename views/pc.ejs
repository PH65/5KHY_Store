<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh mục PC dựng sẵn chính hãng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dienthoai.css">
</head>
<body>
    <%- include('partials/header', { active: 'pc' }) %>

    <main class="container_dienthoai">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a></li>
                <li aria-hidden="true">&gt;</li>
                <li class="active" aria-current="page">PC dựng sẵn</li>
            </ol>
        </nav>

        <h1 class="page-title">PC DỰNG SẴN</h1>

        <section class="filter-section" aria-labelledby="filter-title">
            <h2 class="filter-title" id="filter-title">Danh mục PC theo cấu hình</h2>
            <div class="brand-tags">
                <button type="button" class="brand-btn active" data-brand="all" onclick="filterByBrand(event, 'all')">
                    <span>Tất cả</span>
                </button>
                <button type="button" class="brand-btn" data-brand="Intel Core i9" onclick="filterByBrand(event, 'Intel Core i9')">
                    <span>Intel Core i9</span>
                </button>
                <button type="button" class="brand-btn" data-brand="AMD Ryzen 9" onclick="filterByBrand(event, 'AMD Ryzen 9')">
                    <span>AMD Ryzen 9</span>
                </button>
                <button type="button" class="brand-btn" data-brand="RTX 5070Ti" onclick="filterByBrand(event, 'RTX 5070Ti')">
                    <span>RTX 5070Ti</span>
                </button>
                <button type="button" class="brand-btn" data-brand="RTX 5060Ti" onclick="filterByBrand(event, 'RTX 5060Ti')">
                    <span>RTX 5060Ti</span>
                </button>
            </div>
        </section>

        <!-- THANH TIÊU CHÍ NÂNG CAO VỚI CUSTOM DROPDOWN -->
        <div class="advanced-filter-bar" aria-label="Bộ lọc và sắp xếp PC">
            <div class="dropdowns-group">
                <!-- 1. Vi xử lý (CPU) -->
                <div class="custom-select-wrapper" id="wrapper-cpu" data-filter="cpu">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Vi xử lý</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Vi xử lý</div>
                        <div class="custom-option-item" data-value="i9">Intel Core i9</div>
                        <div class="custom-option-item" data-value="i7">Intel Core i7</div>
                        <div class="custom-option-item" data-value="i5">Intel Core i5</div>
                        <div class="custom-option-item" data-value="ryzen 9">AMD Ryzen 9</div>
                        <div class="custom-option-item" data-value="ryzen 7">AMD Ryzen 7</div>
                        <div class="custom-option-item" data-value="ryzen 5">AMD Ryzen 5</div>
                    </div>
                </div>

                <!-- 2. Card đồ hoạ (VGA) -->
                <div class="custom-select-wrapper" id="wrapper-vga" data-filter="vga">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Card đồ hoạ</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Card đồ hoạ</div>
                        <div class="custom-option-item" data-value="5090">RTX 5090</div>
                        <div class="custom-option-item" data-value="5080">RTX 5080</div>
                        <div class="custom-option-item" data-value="5070">RTX 5070 Series</div>
                        <div class="custom-option-item" data-value="5060">RTX 5060 Series</div>
                        <div class="custom-option-item" data-value="4060">RTX 4060 Series</div>
                        <div class="custom-option-item" data-value="radeon">AMD Radeon</div>
                    </div>
                </div>

                <!-- 3. Dung lượng RAM -->
                <div class="custom-select-wrapper" id="wrapper-ram" data-filter="ram">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Dung lượng RAM</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">RAM</div>
                        <div class="custom-option-item" data-value="16gb">16 GB</div>
                        <div class="custom-option-item" data-value="32gb">32 GB</div>
                        <div class="custom-option-item" data-value="64gb">64 GB</div>
                        <div class="custom-option-item" data-value="128gb">128 GB</div>
                    </div>
                </div>

                <!-- 4. Ổ cứng (Storage) -->
                <div class="custom-select-wrapper" id="wrapper-storage" data-filter="storage">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Ổ cứng</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Ổ cứng</div>
                        <div class="custom-option-item" data-value="512gb">SSD 512 GB</div>
                        <div class="custom-option-item" data-value="1tb">SSD 1 TB</div>
                        <div class="custom-option-item" data-value="2tb">SSD 2 TB</div>
                    </div>
                </div>
            </div>

            <!-- Sắp xếp theo giá -->
            <div class="sort-group" style="display: flex; align-items: center; gap: 10px;">
                <span style="font-family: 'Nunito Sans', sans-serif; font-size: 14px; font-weight: 600; color: #333;">Sắp xếp theo:</span>
                <div class="custom-select-wrapper" id="wrapper-sort" data-filter="sort">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Nổi bật</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="featured">Nổi bật</div>
                        <div class="custom-option-item" data-value="price-asc">Giá thấp đến cao</div>
                        <div class="custom-option-item" data-value="price-desc">Giá cao đến thấp</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="products-grid-layout" id="PCs-container"></div>

        <div class="load-more-container">
            <button type="button" class="load-more-btn">Xem thêm sản phẩm</button>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        const pcsContainer = document.getElementById('PCs-container');
        let allPCsData = [];
        let currentLimit = 20;
        let selectedFilter = 'all';

        // Biến lưu trạng thái bộ lọc PC
        const filterState = {
            cpu: '',
            vga: '',
            ram: '',
            storage: '',
            sort: 'featured'
        };

        // Đọc tham số từ URL (ví dụ: /pc?filter=Intel Core i9 hoặc /pc?filter=RTX 5070Ti)
        const urlParams = new URLSearchParams(window.location.search);
        const filterFromUrl = urlParams.get('filter') || urlParams.get('brand');
        if (filterFromUrl) {
            selectedFilter = filterFromUrl;
        }

        function formatPcPrice(price) {
            if (price === undefined || price === null || price === '' || isNaN(Number(price))) return 'Liên hệ';
            return Number(price).toLocaleString('vi-VN') + 'đ';
        }

        // Khởi tạo sự kiện Custom Dropdown
        document.addEventListener('DOMContentLoaded', function () {
            const dropdowns = document.querySelectorAll('.custom-select-wrapper');

            dropdowns.forEach(wrapper => {
                const trigger = wrapper.querySelector('.custom-select-trigger');
                const options = wrapper.querySelectorAll('.custom-option-item');
                const label = wrapper.querySelector('.selected-label');
                const filterKey = wrapper.dataset.filter;

                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdowns.forEach(w => {
                        if (w !== wrapper) w.classList.remove('open');
                    });
                    wrapper.classList.toggle('open');
                });

                options.forEach(opt => {
                    opt.addEventListener('click', function () {
                        options.forEach(o => o.classList.remove('selected'));
                        this.classList.add('selected');

                        label.textContent = this.textContent;
                        wrapper.classList.remove('open');

                        filterState[filterKey] = this.dataset.value;
                        applyFilters();
                    });
                });
            });

            document.addEventListener('click', function () {
                dropdowns.forEach(wrapper => wrapper.classList.remove('open'));
            });
        });

        fetch('/api/pcs')
            .then(response => response.json())
            .then(data => {
                allPCsData = data;
                
                highlightPcButton(selectedFilter);
                applyFilters();
            })
            .catch(err => console.error('Lỗi tải dữ liệu PC:', err));

        function highlightPcButton(filterValue) {
            document.querySelectorAll('.brand-btn').forEach(btn => {
                const btnBrand = btn.getAttribute('data-brand');
                if (btnBrand && (btnBrand.toLowerCase() === filterValue.toLowerCase() || 
                    filterValue.toLowerCase().includes(btnBrand.toLowerCase()) || 
                    btnBrand.toLowerCase().includes(filterValue.toLowerCase()))) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        function renderPCsUI(pcList) {
            if (!pcsContainer) return;

            if (pcList.length === 0) {
                pcsContainer.innerHTML = `<p style="grid-column: 1/-1; text-align:center; padding: 40px; color: #8e8e93;">Không tìm thấy cấu hình PC nào phù hợp.</p>`;
                toggleLoadMoreButton(false);
                return;
            }

            const displayedPCs = pcList.slice(0, currentLimit);

            pcsContainer.innerHTML = displayedPCs.map((pc, idx) => {
                const currentId = pc._id || idx;
                const displayRating = pc.rating ? Number(pc.rating).toFixed(1) : "0";

                return `
                    <a href="/chitiet?id=${currentId}&type=pc" class="product-card-link" style="text-decoration: none; color: inherit; display: flex;">
                        <article class="product-card" id="pc-card-${idx}">
                            <figure class="prod-img">
                                <img src="${pc.img}" alt="${pc.name}">
                            </figure>
                            <div class="prod-info">
                                <h3 class="prod-name">${pc.name}</h3>
                                <div class="prod-price">${formatPcPrice(pc.price)}</div>
                                <div class="prod-rating">
                                    <i class="fa-solid fa-star"></i> ${displayRating}
                                </div>
                            </div>
                        </article>
                    </a>
                `;
            }).join('');

            toggleLoadMoreButton(currentLimit < pcList.length);
        }

        function toggleLoadMoreButton(show) {
            const loadMoreBtn = document.querySelector('.load-more-btn');
            if (loadMoreBtn) loadMoreBtn.style.display = show ? 'inline-block' : 'none';
        }

        const loadMoreBtn = document.querySelector('.load-more-btn');
        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', function () {
                currentLimit += 20;
                applyFilters(false);
            });
        }

        function filterByBrand(e, brandName) {
            selectedFilter = brandName;
            
            if (e && e.target) {
                const clickedButton = e.target.closest('.brand-btn');
                if (clickedButton) {
                    document.querySelectorAll('.brand-btn').forEach(btn => btn.classList.remove('active'));
                    clickedButton.classList.add('active');
                }
            } else {
                highlightPcButton(brandName);
            }

            applyFilters();
        }

        function getPcNumericPrice(item) {
            if (typeof item.price === 'number') return item.price;
            if (typeof item.price === 'string') {
                const clean = item.price.replace(/[^\d]/g, '');
                return Number(clean) || 0;
            }
            return 0;
        }

        function applyFilters(resetLimit = true) {
            if (resetLimit) {
                currentLimit = 20;
            }
            let filtered = [...allPCsData];

            // 1. Lọc theo Brand Button phía trên
            if (selectedFilter !== 'all') {
                filtered = filtered.filter(item => {
                    const target = selectedFilter.toLowerCase();
                    const brandMatch = item.brand && item.brand.toLowerCase().includes(target);
                    const nameMatch = item.name && item.name.toLowerCase().includes(target);
                    const cpuMatch = item.cpu && item.cpu.toLowerCase().includes(target);
                    const vgaMatch = item.vga && item.vga.toLowerCase().includes(target);
                    const descMatch = item.desc && item.desc.toLowerCase().includes(target);

                    return brandMatch || nameMatch || cpuMatch || vgaMatch || descMatch;
                });
            }

            // 2. Lọc CPU
            if (filterState.cpu) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.cpu || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.cpu.toLowerCase());
                });
            }

            // 3. Lọc VGA (Card màn hình)
            if (filterState.vga) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.vga || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.vga.toLowerCase());
                });
            }

            // 4. Lọc RAM
            if (filterState.ram) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.ram || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.ram.toLowerCase());
                });
            }

            // 5. Lọc Ổ cứng
            if (filterState.storage) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.storage || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.storage.toLowerCase());
                });
            }

            // 6. Sắp xếp giá
            if (filterState.sort === 'price-asc') {
                filtered.sort((a, b) => getPcNumericPrice(a) - getPcNumericPrice(b));
            } else if (filterState.sort === 'price-desc') {
                filtered.sort((a, b) => getPcNumericPrice(b) - getPcNumericPrice(a));
            }

            renderPCsUI(filtered);
        }
    </script>
</body>
</html>