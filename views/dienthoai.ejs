<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh mục Điện thoại chính hãng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css"> 
    <link rel="stylesheet" href="/css/dienthoai.css"> 
</head>
<body>
    <%- include('partials/header', { active: 'dienthoai' }) %>

    <main class="container_dienthoai">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a></li>
                <li aria-hidden="true">&gt;</li>
                <li class="active" aria-current="page">Điện thoại</li>
            </ol>
        </nav>

        <h1 class="page-title">ĐIỆN THOẠI</h1>

        <div class="phone-banners-grid">
            <a href="/chitiet?id=6a538042d177cc3c173a8551&type=phone">
                <figure class="banner-item">
                    <img src="/Hình ảnh/POSTER/DT-Samsung/Samsung-s26-ultra-POSTER.jpg" alt="Galaxy S26 Ultra">
                </figure>
            </a>

            <a href="/chitiet?id=6a538042d177cc3c173a8552&type=phone">
                <figure class="banner-item">
                    <img src="/Hình ảnh/POSTER/DT-Oppo/oppo-find-x9-ultra.png" alt="Oppo Find X9">
                </figure>
            </a>
        </div>

        <section class="filter-section" aria-labelledby="filter-title">
            <h2 class="filter-title" id="filter-title">Danh mục hãng điện thoại</h2>
            <div class="brand-tags">
                <button type="button" class="brand-btn active" data-brand="all" onclick="filterByBrand(event, 'all')">
                    <span>Tất cả</span>
                </button>

                <button type="button" class="brand-btn" data-brand="iPhone" onclick="filterByBrand(event, 'iPhone')">
                    <img src="/Hình ảnh/Logo/iphone-logo.png" alt="Apple" class="brand-logo">
                </button>

                <button type="button" class="brand-btn" data-brand="Samsung" onclick="filterByBrand(event, 'Samsung')">
                    <img src="/Hình ảnh/Logo/samsung-logo.png" alt="Samsung" class="brand-logo">
                </button>

                <button type="button" class="brand-btn" data-brand="Xiaomi" onclick="filterByBrand(event, 'Xiaomi')">
                    <img src="/Hình ảnh/Logo/xiaomi-logo.png" alt="Xiaomi" class="brand-logo">
                </button>

                <button type="button" class="brand-btn" data-brand="Oppo" onclick="filterByBrand(event, 'Oppo')">
                    <img src="/Hình ảnh/Logo/oppo-logo.png" alt="Oppo" class="brand-logo">
                </button>

                <button type="button" class="brand-btn" data-brand="Honor" onclick="filterByBrand(event, 'Honor')">
                    <img src="/Hình ảnh/Logo/honor-logo.png" alt="Honor" class="brand-logo">
                </button>

                <button type="button" class="brand-btn" data-brand="Vivo" onclick="filterByBrand(event, 'Vivo')">
                    <img src="/Hình ảnh/Logo/vivo-logo.png" alt="Vivo" class="brand-logo">
                </button>
            </div>
        </section>

        <!-- THANH TIÊU CHÍ NÂNG CAO VỚI CUSTOM DROPDOWN -->
        <div class="advanced-filter-bar" aria-label="Bộ lọc và sắp xếp">
            <div class="dropdowns-group">
                <!-- 1. Vi xử lý -->
                <div class="custom-select-wrapper" id="wrapper-cpu" data-filter="cpu">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Vi xử lý</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Vi xử lý</div>
                        <div class="custom-option-item" data-value="apple">Apple Silicon</div>
                        <div class="custom-option-item" data-value="snapdragon">Snapdragon</div>
                        <div class="custom-option-item" data-value="helio">MediaTek</div>
                        <div class="custom-option-item" data-value="exynos">Exynos</div>
                    </div>
                </div>

                <!-- 2. Dung lượng RAM -->
                <div class="custom-select-wrapper" id="wrapper-ram" data-filter="ram">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Dung lượng RAM</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Tất cả RAM</div>
                        <div class="custom-option-item" data-value="4gb">4 GB</div>
                        <div class="custom-option-item" data-value="6gb">6 GB</div>
                        <div class="custom-option-item" data-value="8gb">8 GB</div>
                        <div class="custom-option-item" data-value="12gb">12 GB</div>
                        <div class="custom-option-item" data-value="16gb">16 GB</div>
                    </div>
                </div>

                <!-- 3. Bộ nhớ trong -->
                <div class="custom-select-wrapper" id="wrapper-storage" data-filter="storage">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Bộ nhớ trong</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Tất cả bộ nhớ</div>
                        <div class="custom-option-item" data-value="64gb">64 GB</div>
                        <div class="custom-option-item" data-value="128gb">128 GB</div>
                        <div class="custom-option-item" data-value="256gb">256 GB</div>
                        <div class="custom-option-item" data-value="512gb">512 GB</div>
                        <div class="custom-option-item" data-value="1tb">1 TB</div>
                    </div>
                </div>

                <!-- 4. Màn hình -->
                <div class="custom-select-wrapper" id="wrapper-screen" data-filter="screen">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Màn hình</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="">Tất cả kích thước</div>
                        <div class="custom-option-item" data-value="small">Dưới 6.1 inch</div>
                        <div class="custom-option-item" data-value="medium">6.1 - 6.7 inch</div>
                        <div class="custom-option-item" data-value="large">Trên 6.7 inch</div>
                    </div>
                </div>
            </div>

            <!-- Sắp xếp theo giá -->
            <div class="sort-group" style="display: flex; align-items: center; gap: 10px;">
                <span style="font-family: 'Nunito Sans', sans-serif; font-size: 14px; font-weight: 600; color: #333;">Sắp xếp theo:</span>
                <div class="custom-select-wrapper" id="wrapper-sort" data-filter="sort">
                    <div class="custom-select-trigger">
                        <span class="selected-label">Nổi bật</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="custom-options-menu">
                        <div class="custom-option-item selected" data-value="featured">Nổi bật</div>
                        <div class="custom-option-item" data-value="price-asc">Giá thấp đến cao</div>
                        <div class="custom-option-item" data-value="price-desc">Giá cao đến thấp</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="products-grid-layout" id="Phones-container"></div>

        <div class="load-more-container">
            <button type="button" class="load-more-btn">Xem thêm sản phẩm</button>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        function formatVND(price) {
            if (price === undefined || price === null || price === '' || isNaN(price)) return 'Liên hệ';
            return Number(price).toLocaleString('vi-VN') + 'đ';
        }

        const phonesContainer = document.getElementById('Phones-container');
        let allPhonesData = [];
        let currentLimit = 20; 
        let selectedBrand = 'all';

        // Biến lưu trạng thái các bộ lọc hiện tại
        const filterState = {
            cpu: '',
            ram: '',
            storage: '',
            screen: '',
            sort: 'featured'
        };

        // Đọc tham số 'brand' từ URL (ví dụ: /dienthoai?brand=iPhone)
        const urlParams = new URLSearchParams(window.location.search);
        const brandFromUrl = urlParams.get('brand');
        if (brandFromUrl) {
            selectedBrand = brandFromUrl;
        }

        // Khởi tạo sự kiện đóng/mở & chọn cho Custom Dropdown
        document.addEventListener('DOMContentLoaded', function () {
            const dropdowns = document.querySelectorAll('.custom-select-wrapper');

            dropdowns.forEach(wrapper => {
                const trigger = wrapper.querySelector('.custom-select-trigger');
                const options = wrapper.querySelectorAll('.custom-option-item');
                const label = wrapper.querySelector('.selected-label');
                const filterKey = wrapper.dataset.filter;

                // Bấm mở/đóng dropdown
                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdowns.forEach(w => {
                        if (w !== wrapper) w.classList.remove('open');
                    });
                    wrapper.classList.toggle('open');
                });

                // Bấm chọn option
                options.forEach(opt => {
                    opt.addEventListener('click', function () {
                        options.forEach(o => o.classList.remove('selected'));
                        this.classList.add('selected');

                        // Cập nhật text hiển thị trên nút bấm
                        label.textContent = this.textContent;
                        wrapper.classList.remove('open');

                        // Lưu giá trị lọc và kích hoạt lọc lại danh sách
                        filterState[filterKey] = this.dataset.value;
                        applyFilters();
                    });
                });
            });

            // Nhấp chuột ra ngoài thì đóng toàn bộ dropdown
            document.addEventListener('click', function () {
                dropdowns.forEach(wrapper => wrapper.classList.remove('open'));
            });
        });

        // Gọi API lấy dữ liệu điện thoại
        fetch('/api/products') 
            .then(response => response.json())
            .then(data => {
                allPhonesData = data;
                
                if (selectedBrand !== 'all') {
                    highlightBrandButton(selectedBrand);
                }
                
                applyFilters();
            })
            .catch(err => console.error('Lỗi tải dữ liệu điện thoại:', err));

        function highlightBrandButton(brandName) {
            document.querySelectorAll('.brand-btn').forEach(btn => {
                const btnBrand = btn.getAttribute('data-brand');
                if (btnBrand && btnBrand.toLowerCase() === brandName.toLowerCase()) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        function renderPhonesUI(phoneList) {
            if (!phonesContainer) return;

            if (phoneList.length === 0) {
                phonesContainer.innerHTML = `<p style="grid-column: 1/-1; text-align:center; padding: 40px; color: #8e8e93;">Không tìm thấy sản phẩm nào phù hợp.</p>`;
                toggleLoadMoreButton(false);
                return;
            }

            const displayedPhones = phoneList.slice(0, currentLimit);

            phonesContainer.innerHTML = displayedPhones.map((phone, idx) => {
                const variantsHtml = phone.variants ? phone.variants.map((v, i) => `
                    <span class="${i === 0 ? 'active' : ''}" role="button" tabindex="0" data-price="${formatVND(v.price)}" onclick="changePrice(event, this, ${idx})">
                        ${v.storage}
                    </span>
                `).join('') : '';

                const rawPrice = phone.variants && phone.variants[0] ? phone.variants[0].price : phone.price;
                const defaultPrice = formatVND(rawPrice);
                const currentId = phone._id || idx; 
                const displayRating = phone.rating ? Number(phone.rating).toFixed(1) : "0";

                return `
                    <a href="/chitiet?id=${currentId}&type=phone" class="product-card-link">
                        <article class="product-card" id="phone-card-${idx}">
                            <figure class="prod-img">
                                <img src="${phone.img}" alt="${phone.name}">
                            </figure>
                            <div class="prod-info">
                                <h3 class="prod-name">${phone.name}</h3>
                                <div class="prod-variants" onclick="event.preventDefault();">${variantsHtml}</div>
                                <div class="prod-price phone-price-display">${defaultPrice}</div>
                                
                                <div class="prod-rating">
                                    <i class="fa-solid fa-star"></i> ${displayRating}
                                </div>
                            </div>
                        </article>
                    </a>
                `;
            }).join('');

            toggleLoadMoreButton(currentLimit < phoneList.length);
        }

        function changePrice(event, element, idx) {
            event.preventDefault(); 
            const card = document.getElementById(`phone-card-${idx}`);
            if (!card) return;
            card.querySelectorAll('.prod-variants span').forEach(s => s.classList.remove('active'));
            element.classList.add('active');
            card.querySelector('.phone-price-display').innerText = element.getAttribute('data-price');
        }

        function toggleLoadMoreButton(show) {
            const loadMoreBtn = document.querySelector('.load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.style.display = show ? 'inline-block' : 'none';
            }
        }

        const loadMoreBtn = document.querySelector('.load-more-btn');
        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', function () {
                currentLimit += 20; 
                applyFilters(false);
            });
        }

        function filterByBrand(e, brandName) {
            selectedBrand = brandName;
            
            if (e && e.target) {
                const clickedButton = e.target.closest('.brand-btn');
                if (clickedButton) {
                    document.querySelectorAll('.brand-btn').forEach(btn => btn.classList.remove('active'));
                    clickedButton.classList.add('active');
                }
            } else {
                highlightBrandButton(brandName);
            }

            applyFilters();
        }

        function getBasePrice(item) {
            if (item.variants && item.variants.length > 0) {
                return Number(item.variants[0].price) || 0;
            }
            return Number(item.price) || 0;
        }

        function applyFilters(resetLimit = true) {
            if (resetLimit) {
                currentLimit = 20; 
            }
            let filtered = [...allPhonesData];

            // 1. Lọc theo thương hiệu
            if (selectedBrand !== 'all') {
                filtered = filtered.filter(item => 
                    item.brand && item.brand.toLowerCase() === selectedBrand.toLowerCase()
                );
            }

            // 2. Lọc theo Vi xử lý
            if (filterState.cpu) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.cpu || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.cpu.toLowerCase());
                });
            }

            // 3. Lọc theo RAM
            if (filterState.ram) {
                filtered = filtered.filter(item => {
                    const textSearch = ((item.ram || '') + ' ' + (item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.ram.toLowerCase());
                });
            }

            // 4. Lọc theo Bộ nhớ trong
            if (filterState.storage) {
                filtered = filtered.filter(item => {
                    if (item.variants && item.variants.length > 0) {
                        return item.variants.some(v => (v.storage || '').toLowerCase().includes(filterState.storage.toLowerCase()));
                    }
                    const textSearch = ((item.name || '') + ' ' + (item.desc || '')).toLowerCase();
                    return textSearch.includes(filterState.storage.toLowerCase());
                });
            }

            // 5. Sắp xếp giá
            if (filterState.sort === 'price-asc') {
                filtered.sort((a, b) => getBasePrice(a) - getBasePrice(b));
            } else if (filterState.sort === 'price-desc') {
                filtered.sort((a, b) => getBasePrice(b) - getBasePrice(a));
            }

            renderPhonesUI(filtered);
        }
    </script>
</body>
</html>